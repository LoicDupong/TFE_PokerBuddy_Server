# Copy to .env.local (dev) — never commit real values

# Common
NODE_ENV="dev"
PORT=8080
# Frontend origin allowed by CORS (production only)
ALLOWED_ORIGIN=

# Database — use a dev database here, never the production one
DATABASE_URL=
# Set to "false" for a local Postgres without SSL (Docker)
DB_SSL=

# JWT (JSON Web Token)
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
