# Copy to .env.local (dev) — never commit real values

# Common
NODE_ENV="dev"
PORT=8080
# Frontend origin allowed by CORS (production only)
ALLOWED_ORIGIN=

# Database — use a dev database here, never the production one
# Local Docker DB (docker compose up -d):
DATABASE_URL=postgres://pokerbuddy:pokerbuddy@localhost:5433/pokerbuddy
# "false" for the local Docker Postgres (no SSL); leave empty for Neon
DB_SSL=false

# JWT (JSON Web Token)
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Avatars on Cloudinary (production). Leave empty in dev: avatars are saved in uploads/avatars/
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name> (Cloudinary dashboard → API Keys)
CLOUDINARY_URL=

# Client URL (Next.js app), used to build the links sent by email
# (e.g. ${APP_URL}/auth/reset-password?token=…). No trailing slash.
# Falls back to ALLOWED_ORIGIN, then http://localhost:3000.
APP_URL=http://localhost:3000

# Outgoing emails (password reset, password changed alerts) through any SMTP provider.
# Leave SMTP_URL empty in dev: emails (with their links) are printed in the server console instead.
# Outside dev (NODE_ENV not dev/test) without SMTP_URL, nothing is sent and the content is NOT logged.
# Resend (recommended, domain verified in Resend): smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
# Brevo:  smtp://<brevo-smtp-login>:<brevo-smtp-key>@smtp-relay.brevo.com:587
# URL-encode special characters of the password/key (e.g. @ → %40).
SMTP_URL=
# Sender shown to users; must use a domain verified with the SMTP provider
MAIL_FROM="PokerBuddy <no-reply@dupong.be>"
